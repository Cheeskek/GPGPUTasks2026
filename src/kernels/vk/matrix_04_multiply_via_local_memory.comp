#version 450

#include <libgpu/vulkan/vk/common.vk>

#include "../defines.h"

layout (std430, binding = 0) readonly buffer MatrixAIn   { float a[]; }; // rows=h x cols=k
layout (std430, binding = 1) readonly buffer MatrixBIn   { float b[]; }; // rows=k x cols=w
layout (std430, binding = 2)          buffer MatrixCOut  { float c[]; }; // rows=h x cols=w

layout (push_constant) uniform PushConstants {
    uint w;
    uint h;
    uint k;
} params;

#define width GROUP_SIZE_X

layout (local_size_x = GROUP_SIZE_X, local_size_y = GROUP_SIZE_Y) in;
shared float loc_a[GROUP_SIZE];
shared float loc_b[GROUP_SIZE];
void main()
{
	const uint X = gl_GlobalInvocationID.x;
	const uint Y = gl_GlobalInvocationID.y;
	const uint x = gl_LocalInvocationID.x;
	const uint y = gl_LocalInvocationID.y;

    float reg_a = a[x + Y * params.k];
    float reg_b = b[X + y * params.w];

    float accum = 0;
    for (uint i = 0; i < params.k; i += GROUP_SIZE_X) {
        bool load = (i + GROUP_SIZE_X) < params.k;
        loc_a[(x + y) % width + y * width] = reg_a;
        loc_b[(x + y) % width + y * width] = reg_b;
        barrier();
        if (load) {
            reg_a = a[(x + i + GROUP_SIZE_X) + Y * params.k];
            reg_b = b[X + (y + i + GROUP_SIZE_X) * params.w];
        }
        for (uint j = 0; j < GROUP_SIZE_X; ++j) {
            accum += loc_a[(j + y) % width + y * width] * loc_b[(x + j) % width + j * width];
        }
        barrier();
    }
    c[X + Y * params.w] = accum;
}
